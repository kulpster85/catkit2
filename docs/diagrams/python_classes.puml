    }
}

package "catkit2.simulator" {
    class Simulator {
        +time : DataStream
        +main()
        +add_callback(callback_func, t)
        +remove_callback(callback)
        +set_breakpoint(t_until)
        +release_breakpoint(token)
        +start_camera_acquisition(...)
        +end_camera_acquisition(camera_name)
        +camera_readout(camera_name, integrated_power)
        +actuate_dm(dm_name, new_actuators)
        +move_stage(...)
        +switch_power(outlet_name, powered)
        +set_source_power(source_name, power)
    }

    class Callback <<namedtuple>> {
        +time
        +id
        +func
    }

    class OpticalModel {
        +register_plane(plane, dependencies)
        +purge_all()
        +purge_plane(plane_name)
        +plot_graph()
    }

    class SimpleOpticalModel {
    }
}

' Inheritance
BindingsService <|-- Service
BindingsServiceProxy <|-- ServiceProxy
BindingsTestbedProxy <|-- TestbedProxy

ServiceProxy <|-- CameraProxy
ServiceProxy <|-- DeformableMirrorProxy
ServiceProxy <|-- OtherProxies

Service <|-- CameraService
Service <|-- DeformableMirrorService
Service <|-- Simulator
DeformableMirrorService <|-- BmcDeformableMirror

LogObserver <|-- LogWriter
LogObserver <|-- LogTerminal
OpticalModel <|-- SimpleOpticalModel

' Associations
Service o-- TestbedProxy : testbed
Service *-- CatkitLogHandler
ServiceProxy o-- TestbedProxy : testbed
TestbedProxy ..> ServiceProxy : creates via\nentry points
Testbed "1" *-- "many" ServiceReference : services
Testbed *-- "2" ZmqDistributor : log / tracing
Experiment o-- TestbedProxy : testbed
Experiment *-- LogWriter
Experiment *-- LogTerminal
Experiment ..> CatkitLogHandler
Experiment ..> BindingsLogForwarder
CameraService ..> StoppedAcquisition : context manager
CameraService ..> BindingsDataStream : images, temperature
DeformableMirrorService ..> BindingsDataStream : channels,\ntotal_voltage, total_surface
Simulator *-- "many" Callback : callback queue
Simulator o-- OpticalModel : used by subclasses

note bottom of ServiceProxy
  __getattr__ dynamically resolves names to
  properties, commands or data streams
  exposed by the remote service.
end note

note bottom of Testbed
  Runs as the central server process.
  Spawns each service as a separate
  subprocess (sys.executable + script).
end note

@enduml
