@startuml python_classes
title catkit2 - Python class diagram (package catkit2)

skinparam classAttributeIconSize 0
skinparam shadowing false

package "catkit_bindings (C++ via pybind11)" <<Frame>> {
    class "catkit_bindings.Service" as BindingsService
    class "catkit_bindings.ServiceProxy" as BindingsServiceProxy
    class "catkit_bindings.TestbedProxy" as BindingsTestbedProxy
    class "catkit_bindings.DataStream" as BindingsDataStream
    class "catkit_bindings.LogForwarder" as BindingsLogForwarder
}

package "catkit2.testbed" {
    class Service {
        +log : Logger
        -_testbed : TestbedProxy
        -_log_handler : CatkitLogHandler
        +__init__(service_type, **kwargs)
        +testbed : TestbedProxy
        .. inherited from bindings ..
        +run()
        +open()
        +main()
        +close()
        +make_property(name, getter, setter)
        +make_command(name, func)
        +make_data_stream(name, dtype, shape, num_frames)
        +should_shut_down : bool
    }

    class ServiceProxy {
        {static} -_service_interfaces : dict
        -_testbed : TestbedProxy
        +__init__(testbed, service_id)
        +testbed : TestbedProxy
        +__getattr__(name)
        +__setattr__(name, value)
        {static} +get_service_interface(interface_name)
        .. inherited from bindings ..
        +get_property(name)
        +set_property(name, value)
        +execute_command(name, args)
        +get_data_stream(name)
        +property_names
        +command_names
        +data_stream_names
    }

    class TestbedProxy {
        +__init__(host, port)
        +get_service(service_id) : ServiceProxy
        +__getattr__(item) : ServiceProxy
        .. inherited from bindings ..
        +start_service(service_id)
        +stop_service(service_id)
        +config
        +host
        +port
    }

    class Testbed {
        +port : int
        +is_simulated : bool
        +config : dict
        +services : dict[str, ServiceReference]
        +log_distributor : ZmqDistributor
        +tracing_distributor : ZmqDistributor
        +__init__(port, is_simulated, config)
        +run()
        +start_service(service_id)
        +stop_service(service_id)
        +interrupt_service(service_id)
        +terminate_service(service_id)
        +monitor_services()
        +do_heartbeats()
        +shut_down_all_services()
        +on_register_service(data)
        +on_start_service(data)
        +on_get_info(data)
        +reload_config(new_config)
    }

    class ServiceReference {
        +service_id : str
        +service_type : str
        +state : ServiceState
        +dependencies : list
        +requires_safety : bool
        +process_id : int
        +port : int
        +is_alive : bool
        +stop()
        +interrupt()
        +terminate()
    }

    class Experiment {
        +name : str
        +testbed : TestbedProxy
        +metadata : dict
        +is_base_experiment : bool
        +output_path : str
        {static} -_running_experiments : list
        +__init__(testbed, metadata, is_base_experiment)
        +run()
        #pre_experiment()
        #experiment()
        #post_experiment()
        -_compute_output_path()
    }

    class CatkitLogHandler {
        +emit(record)
    }

    class LogObserver {
        +host : str
        +port : int
        +start()
        +stop()
        +loop()
        #handle_message(log_message)
    }

    class LogWriter {
        +output_filename : str
        +output_to(output_filename)
        #handle_message(log_message)
    }

    class LogTerminal {
        #handle_message(log_message)
    }

    class TraceWriter {
        +open(filename)
        +close()
        -_loop()
    }

    class ZmqDistributor {
        +input_port : int
        +output_port : int
        +start()
        +stop()
        -_forwarder()
    }
}

