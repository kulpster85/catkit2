        #start_acquisition() <<abstract>>
        #end_acquisition() <<abstract>>
        #capture_image() <<abstract>>
        +exposure_time
        +gain
        +width / height
        +offset_x / offset_y
    }

    class StoppedAcquisition {
        +__enter__()
        +__exit__()
    }

    class DeformableMirrorService {
        +dm_command_length
        +add_channel(channel_name)
        +open()
        +main()
        +close()
        +monitor_channel(channel_name)
        +update_dm()
        #send_surface(surface) <<abstract>>
    }

    class BmcDeformableMirror {
        +open()
